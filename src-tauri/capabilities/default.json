{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/mediaProcessor",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/mediaProcessProbe",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/imageProcessor",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/mediaProcessProbe",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        "$HOME/**",
        "$DOWNLOAD/**",
        "$DOCUMENT/**"
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "$HOME/**",
        "$DOWNLOAD/**",
        "$DOCUMENT/**"
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        "$HOME/**",
        "$DOWNLOAD/**",
        "$DOCUMENT/**"
      ]
    }
  ]
}